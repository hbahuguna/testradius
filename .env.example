# TestRadius — Environment Configuration
# Copy to .env and fill in values before running docker compose.

# ——— Database ———
DATABASE_URL=postgresql+asyncpg://testsquad:testsquad_password@db:5432/testsquad

# ——— Neo4j Graph ———
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testsquad_password

# ——— Executor ———
EXECUTOR_URL=http://executor:8001

# ——— Authentication (Supabase JWT) ———
# Required for JWT validation. Not needed when DEMO_MODE=true.
# SUPABASE_JWT_SECRET=your-jwt-secret
# SUPABASE_URL=https://your-project.supabase.co

# ——— Demo Mode ———
# Set to "true" to skip JWT auth (uses mock demo user).
# Enable this for development or demonstration.
DEMO_MODE=true

# ——— LLM / AI (optional) ———
# Google Gemini API key for LLM-based test scoring.
# GOOGLE_API_KEY=your-google-api-key

# ——— GitHub (optional) ———
# Personal access token for PR file fetching via GitHub API.
# GITHUB_TOKEN=ghp_your-token

# ——— CORS ———
# Comma-separated list of allowed origins for browser requests.
# Defaults to http://localhost:5173 (Vite dev server).
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ——— Siamese Model (ML profile only) ———
# Path to method2test model directory.
# METHOD2TEST_PATH=/app/method2test

# ——— Workspace (for local brain sync) ———
# Root path for local workspace when no remote repo is configured.
# WORKSPACE_ROOT=/tmp/testsquad-workspaces
