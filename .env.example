# Copy this file to `.env` and fill in your key.
# The key is required for the agentic healer / generator (OpenCode Zen, hy3-free).
# Get one at https://opencode.ai/zen
OPENCODE_API_KEY=sk-...

# Optional: override the browser cache used by Playwright (Node + Python share it).
# PLAYWRIGHT_BROWSERS_PATH=$HOME/Library/Caches/ms-playwright

# Cloud Room Integration (Cloud VM Backend)
EXECUTOR_TYPE=local
CLOUDROOM_URL=http://127.0.0.1:9840
CLOUDROOM_TOKEN=
CLOUDROOM_PROJECT=
EXECUTOR_TIMEOUT=600
