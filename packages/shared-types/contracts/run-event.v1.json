{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testradius.dev/contracts/run-event.v1.json",
  "title": "RunEvent",
  "description": "A single ordered event emitted by the factory cell for one run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "seq", "ts", "type", "payload"],
  "properties": {
    "schema_version": { "const": "1" },
    "run_id": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "type": {
      "enum": ["phase", "step", "tool", "verdict", "log", "stream_lagged"]
    },
    "phase": {
      "enum": ["isolate", "select", "generate", "execute", "prove", "gate", "report", null]
    },
    "payload": { "type": "object" }
  }
}
